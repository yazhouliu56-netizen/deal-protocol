# ─────────────────────────────────────────
# Deal Protocol — 环境变量说明范本（单仓融合版）
# 复制本文件为 .env.local 并填写实际值
# 分组：① Core & Supabase ② Gateway 5 Providers ③ 语音与多模态
#       ④ 支付与通知 ⑤ PWA 推送 ⑥ 遥测与调试
# ─────────────────────────────────────────

# ═══════════════════════════════════════════
# ① Core & Supabase
# ═══════════════════════════════════════════

# Supabase（必填）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 服务端 Supabase Service Role Key（仅用于 API Route / Cron）
# {Supabase 项目 Settings → API → service_role (secret)}
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 本地 Supabase CLI / 数据库密码（scripts/setup-supabase-realtime.ts 等本地脚本用）
SUPABASE_DB_PASSWORD=your_local_db_password

# /api/push 的 url 备用回退（一般无需单独设置）
SUPABASE_URL=

# 站点 URL（Supabase Auth 回调 & 支付回调）
# 生产: https://deal-protocol-phi.vercel.app
# 本地: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ═══════════════════════════════════════════
# ② Gateway Providers（LLM Gateway，src/adapters/ai/gateway/providers.ts）
# ═══════════════════════════════════════════
# 单一来源 provider 表：缺某个 key / 含 placeholder/your_ 占位 / 纯空白 → 该 provider 跳过；全部缺失 → MockEngine 降级。
# 任务路由：chat 首选 gemini；voice-intent/cluster/decompose/diagnose 首选 zhipu。
# 主模型扩展（deepseek/kimi 等）仅注册 tasks: ["chat"]，不污染小模型链路（任务隔离）。
# 根项目 ai-provider.ts 已收敛至此 Gateway（ADR-0005/D-03），经 getAIModel 统一分发。
# 占位符规则：isValidKey 判定（src/adapters/ai/gateway/providers.ts:148）含 placeholder/your_ 即视为未配置。
# NEXT_PUBLIC_LLM_PROVIDER 为构建时内联（build-time inline），改 .env.local 后需 restart dev / 重新 build。

GEMINI_API_KEY=
# ⚠ GEMINI_API_KEY 双用语义：
#   ① 根项目 ai-provider.ts：经 @ai-sdk/google 官方 SDK（gemini-1.5-flash，海外备选）
#   ② Gateway：OpenAI 兼容端点 https://generativelanguage.googleapis.com/v1beta/openai/chat/completions（gemini-2.5-flash）
#   两边共用同一把 key；模型名由 GEMINI_MODEL（Gateway 侧）独立控制。
GEMINI_MODEL=gemini-2.5-flash

ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── 主模型扩展（tasks: ["chat"]，任务隔离） ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek 模型（Gateway 侧经 OpenAI 兼容端点；ai-provider 亦复用此 key）
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek API 端点（官方: https://api.deepseek.com/v1）
# 备选免费节点: https://api.siliconflow.cn/v1（硅基流动）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-32k
# 推荐 32k/128k（moonshot-v1-32k / moonshot-v1-128k），避免长对话在 Compaction 前触发 400 Context Length Exceeded；8k 仅作兼容保留
# KIMI 中转站覆盖（可选，默认 https://api.moonshot.cn/v1，尾部多斜杠已做 /\/+$/ 防御）
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# 兼容 MOONSHOT_* 别名（历史键名）
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-32k
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 客户端 ChatPage 引擎选择（src/components/oto-ui/chat/ChatPage.tsx）
# 取值：任意 Gateway provider 名（gemini | zhipu | qwen | groq | deepseek | kimi | openrouter）；留空或 "mock" → 走 MockEngine（确定性演示）
NEXT_PUBLIC_LLM_PROVIDER=

# ───── 根项目 AI Provider（兼容保留，优先级低于 NEXT_PUBLIC_LLM_PROVIDER，已收敛至 Gateway）─────
# AI Provider 选择: deepseek | gemini | kimi | qwen | groq | openrouter（默认走 Gateway 优先级链）
AI_PROVIDER=deepseek

# GitHub Models token（用于 AI Chat 功能，海外备选）
OPENCODE_GITHUB_TOKEN=your_github_token

# ═══════════════════════════════════════════
# ③ 语音与多模态
# ═══════════════════════════════════════════

# /api/asr + /api/tts（走智谱）：缺 ZHIPU_API_KEY → 两接口 503，
# 前端降级（Web Speech / edge-tts / speechSynthesis）
ZHIPU_ASR_MODEL=glm-asr-2512

# ═══════════════════════════════════════════
# ④ 支付与通知
# ═══════════════════════════════════════════

# ───── SMS Auth (国内手机号验证码 / 阿里云 SMS) ─────
ALIYUN_SMS_ACCESS_KEY_ID=your_aliyun_access_key
# 旧键名 ALIYUN_SMS_ACCESS_KEY 仍被代码兼容读取，新配置请统一使用 ALIYUN_SMS_ACCESS_KEY_ID
ALIYUN_SMS_SECRET=your_aliyun_secret
ALIYUN_SMS_SIGN_NAME=验证登录
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789
# 阶梯告警短信服务商: mock（本地占位，只打日志）| aliyun
SMS_PROVIDER=mock

# ───── Stripe ─────
# 自动识别 Live/Test: sk_live_ → 生产, sk_test_ → 沙箱
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ───── Payment Channel Configuration ─────
# alipay | stripe | mock
PAYMENT_CHANNEL=alipay

# ───── Alipay（选填）─────
ALIPAY_APP_ID=2021000000000000
ALIPAY_PRIVATE_KEY=your_alipay_private_key_pem
ALIPAY_PUBLIC_KEY=your_alipay_public_key_pem
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ───── WeChat Ecosystem (OAuth + Pay) ─────
WECHAT_APP_ID=wx_your_official_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_MCH_ID=your_wechat_merchant_id
WECHAT_PAY_API_KEY=your_wechat_pay_api_v2_or_v3_key
# 模板消息 ID（notification-ladder 微信阶梯告警使用）
WECHAT_TEMPLATE_ID=priority_notification

# ───── Payment ─────
# 异步支付结果通知地址（须使用生产域名）
PAYMENT_NOTIFY_URL=https://deal-protocol-phi.vercel.app
# 生产环境请设为 false
PAYMENT_SANDBOX=false

# ───── Push 通知（服务端；VAPID 见第 ⑤ 组）─────
REDIS_URL=redis://default:password@host:6379
FCM_SERVER_KEY=your_fcm_server_key

# ───── SOS 应急（选填）─────
SMS_API_URL=https://your-sms-api.com/send
SMS_API_KEY=your_sms_api_key
PUSH_API_URL=https://your-push-api.com/send
PUSH_API_KEY=your_push_api_key

# ───── 实名认证（选填）─────
REAL_NAME_API_KEY=your_real_name_api_key

# ───── Cron 鉴权 ─────
CRON_SECRET=your_cron_secret

# ═══════════════════════════════════════════
# ⑤ PWA 推送（web-push VAPID）
# ═══════════════════════════════════════════
# 可由 scripts/generate-vapid.mjs 幂等生成并写入 .env.local

VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@oto.app
# VAPID 公钥的 NEXT_PUBLIC 形式（前端订阅用）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# ═══════════════════════════════════════════
# ⑥ 遥测与调试
# ═══════════════════════════════════════════

# ───── 内部遥测（选填）─────
NEXT_PUBLIC_METRICS_BACKEND=console

# ───── PII 加密 ─────
PII_ENCRYPTION_KEY=your_32_char_hex_key

# ───── 开发与调试（可选）─────
# E2E 脚本浏览器通道：CI 用 chromium（playwright-core 自带）；本地默认 chrome（scripts/e2e-*.mjs）
PLAYWRIGHT_CHANNEL=chromium

# ───── Vercel 自动注入（无需手动填写）─────
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=...
# NEXT_PUBLIC_VERCEL_URL=...
# 方向3 环境弹性：VAPID/PAYMENT 无 Key 时沙盒模拟（红线5 永不中断）
# /api/push/* mocked:true, /api/orders/*/transition split_records 仍守恒落盘, webhooks 幂等台账更新
