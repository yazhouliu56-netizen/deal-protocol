{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
"resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/base/*": [
        "./src/base/*"
      ],
      "@/ammo/*": [
        "./src/ammo/*"
      ],
      "@/store/*": [
        "./oto-spatial-web/src/store/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@oto/*": [
        "./oto-spatial-web/src/*"
      ],
      "@deal-protocol/credit-formula": [
        "./packages/credit-formula/index.ts"
      ],
      "@daviekong/payment-core": [
        "./packages/payment-core/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
"exclude": [
      "node_modules",
      "src/base",
      "src/base/**/*",
      "src/ammo",
      "src/ammo/**/*",
      "oto-spatial-web",
      "oto-spatial-web/**/*",
      "mobile",
      "mobile/**/*",
      "tests",
      "tests/**/*",
      "scripts",
      "scripts/**/*",
      ".next",
      "out",
      ".temp",
      "src/app/sw.ts"
    ]
}
