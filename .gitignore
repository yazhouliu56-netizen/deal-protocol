# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# dev
dev.db
.understand-anything/
.opencode/

.vercel

# local dev logs
dev-server.log
*.log

# local DB artifacts
dev.db
*.db

# serwist build output (regenerated by `next build`)
public/sw.js

# opencode session checkpoint
.opencode-checkpoint.md

# codegraph local index cache
/.codegraph/

# Playwright MCP debug artifacts
.playwright-mcp/

# local dev/prod debug artifacts (screenshots, snapshots, run logs)
oto-spa-*.png
oto-spatial*.png
oto-spatial-snapshot.md
opencode-plugin-cache-check.md

# supabase temp files
supabase/.temp/

# archives
*.tar.gz

# open-mem: Auto-generated folder context files.
# Uncomment to exclude from version control (recommended for large projects):
# **/AGENTS.md

# 规则文件改动前备份（AGENTS.md.bak-* 等）
*.bak-*

# 容灾运行时状态（L6-M3：代理与路由跨 bundle 共享的持久化文件 + 审计）
/.resilience-state.json
/.resilience-audit.jsonl

# E2E acceptance artifacts (screenshots)
.e2e/
