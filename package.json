    "doctor:env": "tsx scripts/doctor-env.mjs",
    "test": "npm run test:units && npm run test:oto:units",
    "test:watch": "vitest",
    "test:units": "vitest run",
    "test:oto:units": "node scripts/run-oto-units.mjs",
    "test:e2e": "node scripts/e2e-match.mjs",
    "test:e2e:app": "node scripts/e2e-app.mjs",
    "test:e2e:wave": "node scripts/e2e-wave.mjs",
    "test:e2e:openmatch": "node scripts/e2e-openmatch.mjs",
    "test:e2e:review": "node scripts/e2e-review.mjs",
