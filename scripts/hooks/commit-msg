#!/bin/sh
# commit-msg 门禁：独立 docs-sync 提交拦截（Step 1 ③b）。
# 约束：sh + 系统命令直调（本仓 npx POSIX shim 已坏）；只读 $1 消息文件，
# 永不 git add、不改工作区；LF 换行（.gitattributes 锁死 eol=lf）。
MSG_FILE="$1"
test -f "$MSG_FILE" || exit 0
SUBJECT=$(head -n 1 "$MSG_FILE")
case "$SUBJECT" in
  Merge*|Revert*|docs\(release\)*|docs\(archive\)*) exit 0 ;;
esac
if printf '%s' "$SUBJECT" | grep -qiE '^docs(\([^)]*\))?:[[:space:]]*(sync|update[[:space:]]+(PROJECT_STATUS|CONVERGENCE-LOG)|status[[:space:]]+sync)'; then
  echo "[commit-msg] BLOCKED: standalone docs-sync commit forbidden." >&2
  echo "Fold status updates into the feat/fix commit that caused them." >&2
  exit 1
fi
# 收敛表禁写（Step 3）：CONVERGENCE-LOG.md 在暂存区时，要求 --staged 定级 ≥T3。
# docs(archive): 主题已在上游白名单放行（批量整理逃生舱）；纯 typo 修复亦请走该主题。
if git diff --cached --name-only | grep -qx "docs/CONVERGENCE-LOG.md"; then
  TIERLINE=$(node scripts/detect-tier.mjs --staged 2>/dev/null | head -n 1)
  case "$TIERLINE" in
    TIER=T3) ;;
    *)
      echo "[commit-msg] BLOCKED: docs/CONVERGENCE-LOG.md staged but tier is ${TIERLINE:-unknown} (< T3)." >&2
      echo "Only T3 (rename/contract) events may touch the convergence log. Use subject 'docs(archive): ...' for bulk archival edits." >&2
      exit 1
      ;;
  esac
fi
exit 0
