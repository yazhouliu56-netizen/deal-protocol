# ============================================================================
# oto-spatial-web 环境变量示例
# 复制为 .env.local 使用（.env.local 已被 .gitignore 忽略，勿提交真实密钥）。
# 注意：Next.js 只读取本目录（oto-spatial-web/.env.local），不读取仓库根 .env.local。
# ============================================================================

# ----------------------------------------------------------------------------
# ① LLM Gateway provider 表（src/base/ai/gateway/providers.ts）
#    缺某个 key → 该 provider 跳过；全部缺失 → 所有 LLM 任务落 MockEngine 降级。
#    任务路由：chat 首选 gemini；voice-intent/cluster/decompose/diagnose 首选 zhipu。
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

GROQ_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 客户端 ChatPage 引擎选择（src/components/chat/ChatPage.tsx）
# 取值：gemini | zhipu；留空 → 走 MockEngine（确定性演示模式）
NEXT_PUBLIC_LLM_PROVIDER=

# ----------------------------------------------------------------------------
# ② 语音链路（src/app/api/asr + src/app/api/tts，走智谱）
#    缺 ZHIPU_API_KEY → 两接口返回 503，前端降级（Web Speech / edge-tts / speechSynthesis）
# ----------------------------------------------------------------------------
ZHIPU_ASR_MODEL=glm-asr-2512

# ----------------------------------------------------------------------------
# ③ Supabase（p2p 跨设备广播 + PWA 推送服务端）
#    url + anon key 同时存在 → transport 走 supabase 实时广播；
#    缺任一 → 自动降级为 local（同设备多 tab 仍可用）
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 推送 API 服务端密钥（/api/push/subscribe、/api/push/send），缺 → 推送不可用
SUPABASE_SERVICE_ROLE_KEY=
# /api/push 的 url 备用回退（一般无需单独设置）
SUPABASE_URL=

# ----------------------------------------------------------------------------
# ④ PWA 真推送（web-push VAPID，见 README「PWA 真推送配置指南」）
#    VAPID_* 可由 scripts/generate-vapid.mjs 幂等生成并写入 .env.local
# ----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oto.app

# ----------------------------------------------------------------------------
# ⑤ 开发脚本（可选）
# ----------------------------------------------------------------------------
# run-dev.mjs 就绪轮询超时（毫秒），默认 180000
DEV_GUARD_TIMEOUT_MS=180000
# E2E 脚本浏览器通道：CI 用 chromium；本地默认 chrome（scripts/e2e-*.mjs）
# PLAYWRIGHT_CHANNEL=chromium
